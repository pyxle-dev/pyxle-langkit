{
  "name": "pyxle-language-tools",
  "displayName": "Pyxle Language Tools",
  "publisher": "pyxle",
  "version": "0.3.0",
  "description": "Language support and debugging for Pyxle .pyxl files — syntax highlighting, diagnostics, completions, hover, go-to-definition, formatting, and full-stack breakpoint debugging.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pyxle-dev/pyxle-langkit"
  },
  "bugs": {
    "url": "https://github.com/pyxle-dev/pyxle-langkit/issues"
  },
  "homepage": "https://pyxle.dev",
  "keywords": [
    "pyxle",
    "pyxl",
    "python",
    "react",
    "jsx",
    "lsp"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "icons/pyxl.png",
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "activationEvents": [
    "onLanguage:pyxle",
    "onDebugResolve:pyxle",
    "onCommand:pyxle.openStudio"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "cd out-test && node --test",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies"
  },
  "contributes": {
    "breakpoints": [
      {
        "language": "pyxle"
      }
    ],
    "commands": [
      {
        "command": "pyxle.openStudio",
        "title": "Pyxle: Open Studio",
        "category": "Pyxle"
      },
      {
        "command": "pyxle.showInstallGuide",
        "title": "Pyxle: Show Language Server Install Guide",
        "category": "Pyxle"
      }
    ],
    "debuggers": [
      {
        "type": "pyxle",
        "label": "Pyxle",
        "languages": [
          "pyxle"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "cwd": {
                "type": "string",
                "description": "Pyxle project root (contains pages/ and pyxle.config.json).",
                "default": "${workspaceFolder}"
              },
              "server": {
                "type": "boolean",
                "description": "Debug the Python side — run the dev server under debugpy so breakpoints in @server loaders and @action handlers bind. Set false to debug only the React/JSX side in a standalone Chrome session.",
                "default": true
              },
              "browser": {
                "type": "boolean",
                "description": "When debugging the Python side, open the app in your browser once the dev server is ready. (React/JSX debugging is a separate launch — set \"server\": false.)",
                "default": true
              },
              "url": {
                "type": "string",
                "description": "Page to open (defaults to the dev server root)."
              },
              "args": {
                "type": "array",
                "description": "Extra arguments passed to `pyxle dev` (e.g. [\"--port\", \"3000\"]).",
                "items": { "type": "string" },
                "default": []
              },
              "justMyCode": {
                "type": "boolean",
                "description": "Restrict Python stepping to your code (set false to step into framework/library code).",
                "default": true
              }
            }
          },
          "attach": {
            "properties": {
              "cwd": {
                "type": "string",
                "description": "Pyxle project root of the running `pyxle dev --inspect` server.",
                "default": "${workspaceFolder}"
              },
              "server": {
                "type": "boolean",
                "description": "Attach the Python debugger to the running dev server.",
                "default": true
              },
              "browser": {
                "type": "boolean",
                "description": "Launch a debug browser for the React side.",
                "default": true
              },
              "url": {
                "type": "string",
                "description": "Page to open in the debug browser (defaults to the dev server root)."
              },
              "justMyCode": {
                "type": "boolean",
                "default": true
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "pyxle",
            "request": "launch",
            "name": "Debug Pyxle app"
          },
          {
            "type": "pyxle",
            "request": "launch",
            "name": "Debug Pyxle app (React browser)",
            "server": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Pyxle: Debug app (Python)",
            "description": "Run the dev server under the debugger — breakpoints in .pyxl @server loaders and @action handlers bind. Opens the app in your browser. One clean debug session.",
            "body": {
              "type": "pyxle",
              "request": "launch",
              "name": "Debug Pyxle app"
            }
          },
          {
            "label": "Pyxle: Debug React (browser)",
            "description": "Debug the React/JSX half in a standalone Chrome session against the running dev server — breakpoints in .pyxl components bind.",
            "body": {
              "type": "pyxle",
              "request": "launch",
              "name": "Debug Pyxle app (React browser)",
              "server": false
            }
          },
          {
            "label": "Pyxle: Debug server only",
            "description": "Python-side debugging of loaders and actions, without opening a browser.",
            "body": {
              "type": "pyxle",
              "request": "launch",
              "name": "Debug Pyxle server",
              "browser": false
            }
          },
          {
            "label": "Pyxle: Attach to running dev server",
            "description": "Attach to an already-running `pyxle dev --inspect` instead of launching one.",
            "body": {
              "type": "pyxle",
              "request": "attach",
              "name": "Attach to Pyxle"
            }
          }
        ]
      }
    ],
    "languages": [
      {
        "id": "pyxle",
        "aliases": [
          "Pyxle",
          "pyxle"
        ],
        "extensions": [
          ".pyxl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pyxl.svg",
          "dark": "./icons/pyxl.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "pyxle",
        "scopeName": "source.pyxle",
        "path": "./syntaxes/pyxl.tmLanguage.json",
        "embeddedLanguages": {
          "source.python": "python",
          "source.js.jsx": "javascriptreact"
        }
      }
    ],
    "configuration": [
      {
        "title": "Pyxle",
        "properties": {
          "pyxle.langserver.command": {
            "type": "string",
            "default": "pyxle-langserver",
            "description": "Command to launch the Pyxle language server. Install via: pip install pyxle-langkit"
          },
          "pyxle.langserver.args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "--stdio"
            ],
            "description": "Arguments forwarded to the language server command."
          },
          "pyxle.formatting.python": {
            "type": "string",
            "default": "ruff",
            "enum": [
              "ruff",
              "black",
              "none"
            ],
            "description": "Python formatter for .pyxl files."
          },
          "pyxle.formatting.jsx": {
            "type": "string",
            "default": "prettier",
            "enum": [
              "prettier",
              "none"
            ],
            "description": "JSX formatter for .pyxl files."
          },
          "pyxle.diagnostics.pyflakes": {
            "type": "boolean",
            "default": true,
            "description": "Enable pyflakes diagnostics for Python sections."
          },
          "pyxle.diagnostics.react": {
            "type": "boolean",
            "default": true,
            "description": "Enable React/JSX analysis via Babel."
          }
        }
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.0"
  }
}
