{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "out-test",
    "rootDir": ".",
    "noEmit": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/discovery.ts",
    "src/interpreter.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out",
    "out-test"
  ]
}
